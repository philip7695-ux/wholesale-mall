generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["mall"]
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  password        String
  name            String
  phone           String?
  role            UserRole       @default(BUYER)
  approvalStatus  ApprovalStatus @default(PENDING)
  businessName    String?
  businessNumber  String?
  businessAddress String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  buyerGrade      BuyerGrade     @default(BRONZE)
  // 거래 유형이 통화와 부가세를 함께 결정한다.
  // 국내 = KRW + 부가세 10%, 수출 = 지정 통화 + 영세율.
  // 기본을 국내로 둔 것은 과소청구(세무 문제)보다 과다청구가 바로잡기 쉽기 때문이다.
  tradeType       TradeType      @default(DOMESTIC)
  // 수출 회원의 결제 통화. 비어 있으면 접속 언어의 기본 통화를 쓴다.
  currency        String?
  cartItems       CartItem[]
  orders          Order[]

  @@schema("mall")
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@schema("mall")
}

model Product {
  id          String           @id @default(cuid())
  name        String
  description String?
  categoryId  String
  thumbnail   String?
  isActive      Boolean          @default(true)
  sortOrder     Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  sizeSpec      String?
  images        String[]
  code          String?          @unique
  material      String?
  // 원본 상품자료에서 함께 들어오는 정보. 코드만으로는 알 수 없다.
  brand         String?          // BEBEDEPINO / Bumkins 등 라인 구분
  origin        String?          // 원산지
  majorCategory String?          // 대분류 (INNER/OUTER/BOTTOM ...)
  moq           Int              @default(0)
  colorMoq      Int              @default(0)
  priceCurrency String           @default("KRW")
  ageGroup      AgeGroup?
  category    Category         @relation(fields: [categoryId], references: [id])
  colors      ProductColor[]
  sizes       ProductSize[]
  variants    ProductVariant[]

  @@index([categoryId])
  @@schema("mall")
}

model ProductColor {
  id        String           @id @default(cuid())
  productId String
  name      String
  colorCode String?
  hexColor  String?
  images    String[]
  sortOrder Int              @default(0)
  moq       Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants  ProductVariant[]

  @@index([productId])
  @@schema("mall")
}

model ProductSize {
  id        String           @id @default(cuid())
  productId String
  name      String
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants  ProductVariant[]

  @@index([productId])
  @@schema("mall")
}

model ProductVariant {
  id         String       @id @default(cuid())
  productId  String
  colorId    String
  sizeId     String
  price      Float
  stock      Int          @default(0)
  sku        String?      @unique
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  cartItems  CartItem[]
  orderItems OrderItem[]
  color      ProductColor @relation(fields: [colorId], references: [id], onDelete: Cascade)
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  size       ProductSize  @relation(fields: [sizeId], references: [id], onDelete: Cascade)

  @@unique([productId, colorId, sizeId])
  @@index([productId])
  @@schema("mall")
}

model CartItem {
  id        String         @id @default(cuid())
  userId    String
  variantId String
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
  @@index([userId])
  @@schema("mall")
}

model Order {
  id              String         @id @default(cuid())
  orderNumber     String         @unique
  invoiceNumber   String?        @unique
  userId          String?
  status               OrderStatus    @default(ORDER_PLACED)
  totalAmount          Float
  paymentMethod        PaymentMethod?
  paymentStatus        PaymentStatus  @default(PENDING)
  paymentKey           String?
  recipientName        String?
  recipientPhone       String?
  shippingAddress      String?
  shippingMemo         String?
  trackingNumber       String?
  shippingCarrier      String?
  invoiceSentAt        DateTime?
  awaitingPaymentAt    DateTime?
  paymentConfirmedAt   DateTime?
  preparingAt          DateTime?
  shippedAt            DateTime?
  deliveredAt          DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  currency        String         @default("KRW")
  exchangeRate    Float          @default(1)
  // 주문 시점 스냅샷. 세율이 바뀌어도 과거 주문은 그대로 남아야 한다.
  supplyAmount    Float          @default(0)
  vatAmount       Float          @default(0)
  vatRate         Float          @default(0)
  gradeDiscount   Float          @default(0)
  deletedUserName String?
  deletedUserEmail String?
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  paymentConfirmations PaymentConfirmation[]

  @@index([userId])
  @@index([orderNumber])
  @@schema("mall")
}

model ExchangeRate {
  id        String   @id @default(cuid())
  currency  String   @unique
  rate      Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("mall")
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  variantId   String?
  quantity    Int
  price       Float
  productName String
  colorName   String
  sizeName    String
  createdAt   DateTime        @default(now())
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@schema("mall")
}

enum UserRole {
  ADMIN
  BUYER

  @@schema("mall")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("mall")
}

enum BuyerGrade {
  BRONZE
  SILVER
  GOLD
  VIP

  @@schema("mall")
}

enum OrderStatus {
  ORDER_PLACED
  INVOICE_SENT
  PAYMENT_CONFIRMED
  SHIPPED
  CANCELLED

  @@schema("mall")
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  VIRTUAL_ACCOUNT
  ALIPAY
  WECHAT

  @@schema("mall")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED

  @@schema("mall")
}

model PaymentConfirmation {
  id              String                     @id @default(cuid())
  orderId         String
  receiptImage    String
  transferDate    DateTime
  amount          Float?
  senderName      String
  status          PaymentConfirmationStatus  @default(PENDING)
  rejectionReason String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  order           Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@schema("mall")
}

enum TradeType {
  DOMESTIC
  EXPORT

  @@schema("mall")
}

enum AgeGroup {
  NEWBORN
  BABY
  KIDS

  @@schema("mall")
}

enum PaymentConfirmationStatus {
  PENDING
  CONFIRMED
  REJECTED

  @@schema("mall")
}

model WiseConfig {
  id        String   @id @default(cuid())
  profileId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("mall")
}

model WiseWebhookLog {
  id         String   @id @default(cuid())
  deliveryId String   @unique
  eventType  String
  payload    String
  matched    Boolean  @default(false)
  orderId    String?
  error      String?
  createdAt  DateTime @default(now())

  @@schema("mall")
}

model PaymentConfig {
  id          String   @id @default(cuid())
  method      String   @unique // BANK_TRANSFER, ALIPAY, WECHAT
  enabled     Boolean  @default(true)
  accountName String   @default("")
  accountInfo String   @default("") // 계좌번호 or 계정 ID
  bankName    String   @default("") // 은행명 (계좌이체용)
  qrCodeUrl   String   @default("") // QR코드 이미지 URL
  memo        String   @default("") // 추가 안내 메모
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@schema("mall")
}

model StoreConfig {
  id             String   @id @default("default")
  companyName    String   @default("")
  address        String   @default("")
  phone          String   @default("")
  email          String   @default("")
  footerMessage  String   @default("Thank you for your business!")
  footerTerms    String   @default("Payment is due within 7 days of invoice date.")
  // 로그인 화면 좌측 대문. 비어 있으면 기본 이미지를 쓴다.
  loginHeroUrl   String   @default("")
  loginTagline   String   @default("Members Only")
  loginTitle     String   @default("Wholesale Fashion Platform")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@schema("mall")
}

model PaymentSetting {
  id             String   @id @default(cuid())
  notificationEmail String?
  bankName       String?
  accountNumber  String?
  accountHolder  String?
  bankNote       String?
  alipayQrImage  String?
  alipayNote     String?
  wechatQrImage  String?
  wechatNote     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@schema("mall")
}

model GradeConfig {
  id           String @id @default(cuid())
  grade        String @unique // BRONZE, SILVER, GOLD, VIP
  discountRate Float  @default(0)
  moqRate      Float  @default(1.0)
  threshold    Int    @default(0) // USD 승급 기준 (0=해당없음)

  @@schema("mall")
}
